                        "optional": true
                    },
                    {
                        "asset_path": "assets/MAPHEAD.WL1",
                        "dos_path": "C:/WOLF3D/MAPHEAD.WL1",
                        "optional": true
                    },
                    {
                        "asset_path": "assets/VGADICT.WL1",
                        "dos_path": "C:/WOLF3D/VGADICT.WL1",
                        "optional": true
                    },
                    {
                        "asset_path": "assets/VGAGRAPH.WL1",
                        "dos_path": "C:/WOLF3D/VGAGRAPH.WL1",
                        "optional": true
                    },
                    {
                        "asset_path": "assets/VGAHEAD.WL1",
