                    },
                    {
                        "asset_path": "assets/WOLF3D.EXE",
                        "dos_path": "C:/WOLF3D/WOLF3D.EXE",
                        "optional": true
                    }
                ],
                "autoexec": [
                    "C:",
                    "cd WOLF3D",
                    "SET BLASTER=A220 I7 D1 T4"
                ]
            },
            "saves": {
                "enabled": true,
                "scope": "shared",
                "save_paths": [
                    "C:/WOLF3D/DEFAULT.CFG"
                ],
                "max_size_kb": 512
            }
        }
    },
    "credits": {
        "session_cost": 0
    },
    "saves": {
        "enabled": true,
        "scope": "user",
        "save_paths": [
            "C:/WOLF3D/*.SAV",
            "C:/WOLF3D/*.CFG"
        ],
        "max_size_kb": 512
    }
}
