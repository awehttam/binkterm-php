{% extends "base.twig" %}

{% block title %}{{ t('ui.echolist.page_title') }} - {{ parent() }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="/css/echo-filter.css">
{% endblock %}

{% block content %}
<style>
/* Minimal scoped styles for echolist page */
#echolist-page .echoarea-icon {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.5rem;
    flex-shrink: 0;
}

#echolist-page .echoarea-title {
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.25rem;
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
}

#echolist-page .echoarea-desc {
    font-size: 0.9rem;
    color: #6c757d;
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    white-space: normal !important;
    display: block !important;
}

#echolist-page .list-group-item {
    overflow: hidden !important;
}

#echolist-page .d-flex {
    min-width: 0 !important;
}

#echolist-page .echoarea-mod {
    font-size: 0.85rem;
    color: #868e96;
}

#echolist-page .network-badge {
    font-size: 0.85rem;
}

#echolist-page .echoarea-stats {
    max-width: 45%;
    flex: 0 1 auto;
}

#echolist-page .echoarea-stats .badge {
    white-space: normal !important;
    text-align: right;
}

#echolist-page .echoarea-row-link {
    color: inherit;
    text-decoration: none;
    min-width: 0;
}

#echolist-page .echoarea-row-link:hover {
    color: inherit;
}

#echolist-page .area-select-checkbox {
    margin-top: 0.2rem;
}

#areaBulkActionsBar {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    z-index: 1030;
    width: calc(100% - 2rem);
    max-width: 560px;
}

@media (max-width: 575.98px) {
    #areaBulkActionsBar .btn-text {
        display: none;
    }
}

@media (max-width: 767.98px) {
    #echolist-page .echoarea-icon {
        width: 40px;
        height: 40px;
        font-size: 1.2rem;
    }

    #echolist-page .d-none-mobile {
        display: none !important;
    }
}
</style>

<div id="echolist-page">
    <div class="page-header">
        <h2>
            <i class="fas fa-comments"></i>
            {{ t('ui.echolist.heading') }}
        </h2>
    </div>

    <!-- Hidden state elements preserved for filtering & preferences -->
    <input type="checkbox" id="subscribedOnlyCheck" class="d-none">
    <input type="checkbox" id="unreadOnlyCheck" class="d-none">
    <input type="text" id="areaSearch" class="d-none">

    <!-- Quick Filter & Action Toolbar -->
    <div class="card mb-3" id="echolist-top-filter-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fas fa-search me-2"></i>{{ t('ui.echolist.search_heading') }}</h6>
            <div class="echo-view-switcher btn-group btn-group-sm">
                <button type="button" class="btn btn-primary active" title="{{ t('ui.echolist.view_area_list') }}">
                    <i class="fas fa-list me-1"></i> {{ t('ui.echolist.view_area_list') }}
                </button>
                <a href="/echomail" class="btn btn-outline-secondary" id="echo-header-toggle-messages" title="{{ t('ui.echolist.view_messages') }}">
                    <i class="fas fa-envelope-open-text me-1"></i> {{ t('ui.echolist.view_messages') }}
                </a>
            </div>
        </div>
        <div class="card-body">
            <form onsubmit="searchMessages(); return false;">
                <div class="input-group">
                    <input type="text" class="form-control" id="messageSearch" placeholder="{{ t('ui.echolist.search_placeholder') }}">
                    <button class="btn btn-primary" type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
                <small class="text-muted d-block mt-1">{{ t('ui.echolist.search_help') }}</small>
            </form>

            <div id="echo-button-toolbar" class="echo-button-toolbar">
                <div class="echo-section-title">
                    <span><i class="fas fa-network-wired me-1"></i> {{ t('ui.echolist.quick_network_filters') }}</span>
                    <span class="badge bg-secondary" id="echo-badge-total">-</span>
                </div>
                <div class="echo-btn-group mb-3" id="echo-network-buttons">
                    <button type="button" class="btn btn-sm btn-primary active echo-btn" data-net="all">
                        <i class="fas fa-border-all me-1"></i> ALL
                    </button>
                </div>

                <div class="echo-section-title" id="echo-subarea-section-title">
                    <span><i class="fas fa-layer-group me-1"></i> {{ t('ui.echolist.quick_subarea_filters') }}</span>
                    <div class="d-flex align-items-center gap-2">
                        <input type="text" class="form-control form-control-sm echo-subarea-search" id="echo-subarea-search-input" placeholder="{{ t('ui.echolist.filter_subareas_placeholder') }}" style="height: 24px; font-size: 0.72rem; padding: 2px 6px; width: 130px;">
                        <span class="badge bg-secondary" id="echo-badge-subareas">-</span>
                    </div>
                </div>
                <div class="echo-btn-group echo-subarea-group mb-3" id="echo-subarea-buttons">
                    <span class="text-muted small p-1">{{ t('ui.echolist.loading') }}</span>
                </div>

                <div class="echo-section-title">
                    <span><i class="fas fa-bolt me-1"></i> {{ t('ui.echolist.quick_actions') }}</span>
                </div>
                <div class="echo-btn-group" id="echo-action-buttons">
                    <button type="button" class="btn btn-sm btn-outline-secondary echo-btn echo-action-btn" id="echo-btn-subscribed" title="{{ t('ui.echolist.show_subscribed_only') }}">
                        <i class="fa-solid fa-star me-1 text-warning"></i> {{ t('ui.interests.subscribed') }}
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary echo-btn echo-action-btn" id="echo-btn-unread" title="{{ t('ui.echolist.show_unread_only') }}">
                        <i class="fas fa-envelope me-1 text-info"></i> {{ t('ui.common.unread') }}
                    </button>
                    <a href="/echomail" class="btn btn-sm btn-outline-secondary echo-btn echo-action-btn" id="echo-btn-view-toggle" title="{{ t('ui.echolist.view_messages') }}">
                        <i class="fas fa-envelope-open-text me-1 text-primary"></i> {{ t('ui.echolist.view_messages') }}
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-secondary echo-btn echo-action-btn" id="echo-btn-newpost" title="{{ t('ui.echolist.new_post') }}" onclick="composeMessage('echomail')">
                        <i class="fas fa-plus me-1 text-success"></i> {{ t('ui.echolist.new_post') }}
                    </button>
                    <a href="/subscriptions" class="btn btn-sm btn-outline-secondary echo-btn echo-action-btn" title="{{ t('ui.echomail.manage_subscriptions') }}">
                        <i class="fa-solid fa-wrench me-1"></i> {{ t('ui.common.manage') }}
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div id="forumsContainer">
        <div class="loading">
            <i class="fas fa-spinner fa-spin me-2"></i>
            {{ t('ui.echolist.loading') }}
        </div>
    </div>

    <div id="areaBulkActionsBar" class="d-none card shadow-lg bg-dark text-white border-0">
        <div class="card-body d-flex align-items-center justify-content-between gap-2 py-2 px-3">
            <span class="fw-semibold small" id="areaBulkSelectedCount">{{ t('ui.echolist.selected_count', {count: 0}) }}</span>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-light" onclick="toggleSelectAllAreas()">
                    <i class="fas fa-check-double"></i> <span class="btn-text">{{ t('ui.echolist.select_all') }}</span>
                </button>
                <button type="button" class="btn btn-sm btn-primary" id="areaBulkMarkReadBtn" onclick="markSelectedAreasAsRead()" disabled>
                    <i class="fas fa-envelope-open"></i> <span class="btn-text">{{ t('ui.echolist.mark_selected_read') }}</span>
                </button>
                <button type="button" class="btn btn-sm btn-outline-light" onclick="toggleAreaSelectMode()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="stats-bar">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 stat-box">
                        <h5 id="totalAreas">-</h5>
                        <small>{{ t('ui.echolist.stats.total_echos') }}</small>
                    </div>
                    <div class="col-md-3 stat-box">
                        <h5 id="totalMessages">-</h5>
                        <small>{{ t('ui.echolist.stats.total_messages') }}</small>
                    </div>
                    <div class="col-md-3 stat-box">
                        <h5 id="totalNetworks">-</h5>
                        <small>{{ t('ui.echolist.stats.networks') }}</small>
                    </div>
                    <div class="col-md-3 stat-box">
                        <h5 id="recentMessages">-</h5>
                        <small>{{ t('ui.echolist.stats.recent_messages') }}</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
let allEchoAreas = [];
let searchQuery = '';
let areaSelectMode = false;
let selectedAreas = new Set();
let activeNetwork = 'all';
let activeSubArea = 'all';

function uiT(key, fallback, params = {}) {
    if (window.t) {
        return window.t(key, params, fallback);
    }
    return fallback;
}

function updateToolbarToggleLinks() {
    const net = activeNetwork && activeNetwork !== 'all' ? activeNetwork : null;
    let msgUrl = '/echomail';
    if (activeSubArea && activeSubArea !== 'all') {
        const found = allEchoAreas.find(a => (a.tag || '').toLowerCase() === activeSubArea.toLowerCase());
        if (found) {
            const areaDom = (found.domain || '').toString().trim();
            const fullTag = areaDom ? `${found.tag}@${areaDom}` : found.tag;
            msgUrl = `/echomail/${encodeURIComponent(fullTag)}${net ? '?net=' + encodeURIComponent(net) : ''}`;
        } else {
            msgUrl = `/echomail/${encodeURIComponent(activeSubArea)}${net ? '?net=' + encodeURIComponent(net) : ''}`;
        }
    } else if (net) {
        msgUrl = `/echomail?net=${encodeURIComponent(net)}`;
    }

    const toggleBtn = document.getElementById('echo-btn-view-toggle');
    if (toggleBtn) toggleBtn.href = msgUrl;
    const headerToggle = document.getElementById('echo-header-toggle-messages');
    if (headerToggle) headerToggle.href = msgUrl;
}

function saveEcholistPreferences() {
    $.ajax({
        url: '/api/user/echolist-preference',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            subscribed_only: $('#subscribedOnlyCheck').is(':checked'),
            unread_only:     $('#unreadOnlyCheck').is(':checked'),
            network:         activeNetwork,
            subarea:         activeSubArea
        })
    });
}

function syncQuickActionButtons() {
    const isSubscribed = $('#subscribedOnlyCheck').is(':checked');
    const isUnread = $('#unreadOnlyCheck').is(':checked');

    const subBtn = $('#echo-btn-subscribed');
    if (subBtn.length) {
        if (isSubscribed) {
            subBtn.removeClass('btn-outline-secondary').addClass('btn-primary active');
        } else {
            subBtn.removeClass('btn-primary active').addClass('btn-outline-secondary');
        }
    }

    const unreadBtn = $('#echo-btn-unread');
    if (unreadBtn.length) {
        if (isUnread) {
            unreadBtn.removeClass('btn-outline-secondary').addClass('btn-primary active');
        } else {
            unreadBtn.removeClass('btn-primary active').addClass('btn-outline-secondary');
        }
    }
}

function renderNetworkToolbarButtons() {
    const netContainer = document.getElementById('echo-network-buttons');
    if (!netContainer) return;

    let localCount = 0;
    const domainCounts = {};

    allEchoAreas.forEach(function(area) {
        if (area.is_local) {
            localCount++;
        } else {
            const dom = (area.domain || 'unknown').toLowerCase();
            domainCounts[dom] = (domainCounts[dom] || 0) + 1;
        }
    });

    const badgeTotal = document.getElementById('echo-badge-total');
    if (badgeTotal) {
        badgeTotal.textContent = allEchoAreas.length + ' Areas';
    }

    const isAllActive = (activeNetwork === 'all');
    let html = `
        <button type="button" class="btn btn-sm ${isAllActive ? 'btn-primary active' : 'btn-outline-secondary'} echo-btn" data-net="all">
            <i class="fas fa-border-all me-1"></i> ALL
            <span class="badge ${isAllActive ? 'bg-dark' : 'bg-secondary'} ms-1">${allEchoAreas.length}</span>
        </button>
    `;

    if (localCount > 0) {
        const isLocalActive = (activeNetwork === '__local__' || activeNetwork === 'local');
        html += `
            <button type="button" class="btn btn-sm ${isLocalActive ? 'btn-primary active' : 'btn-outline-secondary'} echo-btn" data-net="__local__">
                <i class="fas fa-home me-1"></i> LOCAL
                <span class="badge ${isLocalActive ? 'bg-dark' : 'bg-secondary'} ms-1">${localCount}</span>
            </button>
        `;
    }

    const domains = Object.keys(domainCounts).sort();
    domains.forEach(function(dom) {
        const count = domainCounts[dom];
        const label = dom.toUpperCase();
        const isNetActive = (activeNetwork === dom);
        html += `
            <button type="button" class="btn btn-sm ${isNetActive ? 'btn-primary active' : 'btn-outline-secondary'} echo-btn" data-net="${dom}">
                <i class="fas fa-comments me-1"></i> ${label}
                <span class="badge ${isNetActive ? 'bg-dark' : 'bg-secondary'} ms-1">${count}</span>
            </button>
        `;
    });

    netContainer.innerHTML = html;

    $(netContainer).find('.echo-btn').on('click', function() {
        this.blur();
        const net = $(this).attr('data-net');
        selectToolbarNetwork(net);
    });
}

function renderSubareaToolbarButtons() {
    const container = document.getElementById('echo-subarea-buttons');
    const badgeSubareas = document.getElementById('echo-badge-subareas');
    if (!container) return;

    let filtered = allEchoAreas.slice();
    if (activeNetwork === '__local__' || activeNetwork === 'local') {
        filtered = filtered.filter(a => !!a.is_local);
    } else if (activeNetwork !== 'all') {
        filtered = filtered.filter(a => (a.domain || '').toLowerCase() === activeNetwork.toLowerCase());
    }

    if ($('#unreadOnlyCheck').is(':checked')) {
        filtered = filtered.filter(a => (a.unread_count || 0) > 0);
    }

    if (badgeSubareas) {
        badgeSubareas.textContent = filtered.length + ' Areas';
    }

    if (filtered.length === 0) {
        container.innerHTML = `<span class="text-muted small p-1">${uiT('ui.echolist.no_subareas_match', 'No sub-areas match the current filter.')}</span>`;
        return;
    }

    filtered.sort((a, b) => (a.tag || '').localeCompare(b.tag || ''));

    const netName = (activeNetwork === 'all') ? 'AREAS' : (activeNetwork === '__local__' || activeNetwork === 'local' ? 'LOCAL' : activeNetwork.toUpperCase());
    const allLabel = uiT('ui.echolist.all_areas_label', `ALL ${netName}`, { name: netName });
    const isAllActive = (!activeSubArea || activeSubArea === 'all');

    let html = `
        <button type="button" class="btn btn-sm ${isAllActive ? 'btn-primary active' : 'btn-outline-secondary'} echo-btn echo-subarea-btn" data-subarea="all">
            <i class="fas fa-layer-group me-1"></i> ${escapeHtml(allLabel)}
            <span class="badge ${isAllActive ? 'bg-dark' : 'bg-secondary'} ms-1">${filtered.length}</span>
        </button>
    `;

    filtered.forEach(function(area) {
        const areaDomain = (area.domain || '').toString().trim();
        const fullTag = areaDomain ? `${area.tag}@${areaDomain}` : area.tag;
        const isSubActive = activeSubArea && (
            activeSubArea.toLowerCase() === (area.tag || '').toLowerCase() ||
            activeSubArea.toLowerCase() === fullTag.toLowerCase()
        );

        let badgeHtml = '';
        const unread = area.unread_count || 0;
        const total = area.message_count || 0;
        if (unread > 0) {
            badgeHtml = `<span class="badge bg-danger ms-1" title="${unread} unread">${unread}</span>`;
        } else if (total > 0) {
            badgeHtml = `<span class="badge ${isSubActive ? 'bg-dark' : 'bg-secondary'} ms-1" title="${total} posts">${total}</span>`;
        }

        html += `
            <button type="button" class="btn btn-sm ${isSubActive ? 'btn-primary active' : 'btn-outline-secondary'} echo-btn echo-subarea-btn" data-subarea="${escapeHtml((area.tag || '').toLowerCase())}" title="${escapeHtml(area.description || area.tag)}">
                <i class="fas fa-comments me-1"></i> ${escapeHtml(area.tag)}
                ${badgeHtml}
            </button>
        `;
    });

    container.innerHTML = html;

    $(container).find('.echo-subarea-btn').on('click', function() {
        this.blur();
        const sub = $(this).attr('data-subarea');
        selectToolbarSubArea(sub);
    });

    filterSubareaButtonsBySearch();
}

function filterSubareaButtonsBySearch() {
    const input = document.getElementById('echo-subarea-search-input');
    if (!input) return;
    const q = input.value.trim().toLowerCase();
    const container = document.getElementById('echo-subarea-buttons');
    if (!container) return;

    let visibleCount = 0;
    $(container).find('.echo-subarea-btn').each(function() {
        const sub = ($(this).attr('data-subarea') || '').toLowerCase();
        const title = ($(this).attr('title') || '').toLowerCase();
        if (sub === 'all' || !q || sub.includes(q) || title.includes(q)) {
            $(this).show();
            visibleCount++;
        } else {
            $(this).hide();
        }
    });

    const badgeSubareas = document.getElementById('echo-badge-subareas');
    if (badgeSubareas) {
        badgeSubareas.textContent = visibleCount + ' Areas';
    }
}

function selectToolbarNetwork(net) {
    activeNetwork = (net || 'all').toLowerCase();
    activeSubArea = 'all';

    // Update active state on network buttons
    $('#echo-network-buttons .echo-btn').each(function() {
        const btnNet = $(this).attr('data-net');
        const badge = $(this).find('.badge');
        if (btnNet === activeNetwork) {
            $(this).removeClass('btn-outline-secondary').addClass('btn-primary active');
            badge.removeClass('bg-secondary').addClass('bg-dark');
        } else {
            $(this).removeClass('btn-primary active').addClass('btn-outline-secondary');
            badge.removeClass('bg-dark').addClass('bg-secondary');
        }
    });

    // Sync Binkterm core network dropdown checkboxes
    $('#networkDropdown .network-cb').each(function() {
        if (activeNetwork === 'all') {
            $(this).prop('checked', false);
        } else {
            $(this).prop('checked', $(this).val().toLowerCase() === activeNetwork);
        }
    });
    updateNetworkPickerLabel();

    renderSubareaToolbarButtons();
    updateToolbarToggleLinks();
    saveEcholistPreferences();

    $('#areaSearch').val('');
    searchEchoAreas('');
}

function selectToolbarSubArea(sub) {
    activeSubArea = (sub || 'all').toLowerCase();

    $('#echo-subarea-buttons .echo-subarea-btn').each(function() {
        const s = ($(this).attr('data-subarea') || '').toLowerCase();
        const isMatch = (activeSubArea === 'all' && s === 'all') || (activeSubArea !== 'all' && s === activeSubArea);
        const badge = $(this).find('.badge');
        if (isMatch) {
            $(this).removeClass('btn-outline-secondary').addClass('btn-primary active');
            if (badge.length && !badge.hasClass('bg-danger')) {
                badge.removeClass('bg-secondary').addClass('bg-dark');
            }
        } else {
            $(this).removeClass('btn-primary active').addClass('btn-outline-secondary');
            if (badge.length && !badge.hasClass('bg-danger')) {
                badge.removeClass('bg-dark').addClass('bg-secondary');
            }
        }
    });

    updateToolbarToggleLinks();
    saveEcholistPreferences();

    const areaSearchInput = $('#areaSearch');
    if (activeSubArea === 'all') {
        areaSearchInput.val('');
        searchEchoAreas('');
    } else {
        areaSearchInput.val(activeSubArea);
        searchEchoAreas(activeSubArea);
    }
}

$(document).ready(function() {
    // Sub-area search input listener
    $('#echo-subarea-search-input').on('input', filterSubareaButtonsBySearch);

    // Quick Actions Click Handlers
    $('#echo-btn-subscribed').on('click', function() {
        this.blur();
        const nextState = !$('#subscribedOnlyCheck').is(':checked');
        $('#subscribedOnlyCheck').prop('checked', nextState);
        toggleSubscribedFilter();
    });

    $('#echo-btn-unread').on('click', function() {
        this.blur();
        const nextState = !$('#unreadOnlyCheck').is(':checked');
        $('#unreadOnlyCheck').prop('checked', nextState);
        toggleUnreadFilter();
    });

    // Load saved preferences from database
    loadI18nNamespaces(['common', 'errors']).then(function() {
        loadInterestFilter();
        const urlParams = new URLSearchParams(window.location.search);
        const urlNet = urlParams.get('net');
        const urlArea = urlParams.get('area');

        $.get('/api/user/echolist-preference')
            .done(function(data) {
                const subOnly = (data.subscribed_only !== undefined) ? data.subscribed_only : true;
                $('#subscribedOnlyCheck').prop('checked', !!subOnly);
                if (data.unread_only) $('#unreadOnlyCheck').prop('checked', true);

                activeNetwork = (urlNet || data.network || 'all').toLowerCase();
                activeSubArea = (urlArea || data.subarea || 'all').toLowerCase();

                syncQuickActionButtons();
                loadEchoAreas();
                loadStatistics();
            })
            .fail(function() {
                $('#subscribedOnlyCheck').prop('checked', true);
                syncQuickActionButtons();
                loadEchoAreas();
                loadStatistics();
            });
    });

    // Auto refresh every 2 minutes
    setInterval(function() {
        loadEchoAreas();
        loadStatistics();
    }, 120000);
});

let allInterests = [];

function loadInterestFilter() {
    if (!document.getElementById('interestDropdown')) return;
    $.get('/api/interests')
        .done(function(data) {
            allInterests = data.interests || [];
            populateInterestFilter();
        });
}

function populateInterestFilter() {
    const ul = $('#interestDropdown');
    const prevChecked = new Set(
        $('#interestDropdown .interest-cb:checked').map(function() { return this.value; }).get()
    );

    ul.empty();

    const subscribedOnly = $('#subscribedOnlyCheck').is(':checked');
    const interests = subscribedOnly ? allInterests.filter(i => i.subscribed) : allInterests;

    if (!interests.length) {
        ul.append('<li><span class="dropdown-item-text text-muted small">' + uiT('ui.interests.no_interests', 'No interests defined') + '</span></li>');
        return;
    }

    interests.forEach(interest => {
        const checked = prevChecked.has(String(interest.id)) ? ' checked' : '';
        const dot = `<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:${escapeHtml(interest.color || '#6c757d')};flex-shrink:0"></span>`;
        ul.append($(`<li><label class="dropdown-item d-flex align-items-center gap-2 py-1 px-2">
            <input type="checkbox" class="form-check-input interest-cb flex-shrink-0" value="${escapeHtml(String(interest.id))}"${checked}>
            ${dot}
            <span class="small">${escapeHtml(interest.name)}</span>
        </label></li>`));
    });

    ul.find('.interest-cb').on('change', function() {
        updateInterestPickerLabel();
        searchEchoAreas($('#areaSearch').val());
    });

    updateInterestPickerLabel();
}

function updateInterestPickerLabel() {
    const allLabel = uiT('ui.echolist.all_interests', 'All Interests');
    const checked = $('#interestDropdown .interest-cb:checked').map(function() {
        return $(this).closest('label').find('span.small').text().trim();
    }).get();
    $('#interestPickerLabel').text(checked.length > 0 ? checked.join(', ') : allLabel);
}

function loadEchoAreas() {
    const subscribedOnly = $('#subscribedOnlyCheck').is(':checked');
    const url = '/api/echoareas?subscribed_only=' + subscribedOnly;

    $.get(url)
        .done(function(data) {
            allEchoAreas = data.echoareas || [];

            renderNetworkToolbarButtons();
            renderSubareaToolbarButtons();
            syncQuickActionButtons();
            updateToolbarToggleLinks();

            populateNetworkFilter();
            if (document.getElementById('interestDropdown')) populateInterestFilter();
            searchEchoAreas(searchQuery);
            const networks = new Set();
            allEchoAreas.forEach(f => {
                networks.add(f.is_local ? uiT('ui.echolist.local', 'Local') : (f.domain || uiT('ui.echolist.unknown', 'Unknown')));
            });
            $('#totalNetworks').text(networks.size);
        })
        .fail(function() {
            $('#forumsContainer').html(`<div class="alert alert-danger">${uiT('ui.echolist.load_failed', 'Failed to load echo areas')}</div>`);
        });
}

function populateNetworkFilter() {
    const localLabel = uiT('ui.echolist.local', 'Local');
    const networks = new Set();
    let hasLocal = false;

    allEchoAreas.forEach(f => {
        if (f.is_local) {
            hasLocal = true;
        } else {
            networks.add(f.domain || uiT('ui.echolist.unknown', 'Unknown'));
        }
    });

    // Remember current selections before rebuilding
    const prevChecked = new Set(
        $('#networkDropdown .network-cb:checked').map(function() { return this.value; }).get()
    );

    const ul = $('#networkDropdown');
    ul.empty();

    const makeItem = (value, label) => {
        const checked = prevChecked.has(value) ? ' checked' : '';
        return $(`<li><label class="dropdown-item d-flex align-items-center gap-2 py-1 px-2">
            <input type="checkbox" class="form-check-input network-cb flex-shrink-0" value="${escapeHtml(value)}"${checked}>
            <span class="small">${escapeHtml(label)}</span>
        </label></li>`);
    };

    if (hasLocal) ul.append(makeItem('__local__', localLabel));
    [...networks].sort().forEach(net => ul.append(makeItem(net, net.toUpperCase())));

    if (!hasLocal && networks.size === 0) {
        ul.append('<li><span class="dropdown-item-text text-muted small">No networks</span></li>');
    }

    ul.find('.network-cb').on('change', function() {
        updateNetworkPickerLabel();
        searchEchoAreas($('#areaSearch').val());
    });

    updateNetworkPickerLabel();
}

function updateNetworkPickerLabel() {
    const allNetworksLabel = uiT('ui.echolist.all_networks', 'All Networks');
    const checked = $('#networkDropdown .network-cb:checked').map(function() {
        return $(this).closest('label').find('span').text().trim();
    }).get();
    $('#networkPickerLabel').text(checked.length > 0 ? checked.join(', ') : allNetworksLabel);
}

function toggleSubscribedFilter() {
    saveEcholistPreferences();
    loadEchoAreas();
    loadStatistics();
}

function toggleUnreadFilter() {
    saveEcholistPreferences();
    searchEchoAreas(searchQuery);
}

function displayEchoAreas(areas) {
    if (areas.length === 0) {
        $('#forumsContainer').html(`<div class="empty-state"><i class="fas fa-inbox fa-3x mb-3"></i><p>${uiT('ui.echolist.none_available', 'No echo areas available.')}</p></div>`);
        return;
    }

    // Group by network
    const localLabel = uiT('ui.echolist.local', 'Local');
    const groups = { [localLabel]: [] };

    areas.forEach(area => {
        if (area.is_local) {
            groups[localLabel].push(area);
        } else {
            const net = area.domain || uiT('ui.echolist.unknown', 'Unknown');
            if (!groups[net]) groups[net] = [];
            groups[net].push(area);
        }
    });

    let html = '';
    html += '<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">';

    // Bulk selection mode toggle (left side) - actions themselves live in the
    // floating #areaBulkActionsBar so they stay reachable without scrolling back up.
    html += '<div class="d-flex align-items-center gap-2 flex-wrap">';
    html += `<button type="button" class="btn btn-sm ${areaSelectMode ? 'btn-outline-warning' : 'btn-outline-secondary'}" id="areaSelectModeBtn" onclick="toggleAreaSelectMode()">`;
    html += areaSelectMode
        ? `<i class="fas fa-times"></i> ${uiT('ui.common.cancel', 'Cancel')}`
        : `<i class="fas fa-check-square"></i> ${uiT('ui.common.select', 'Select')}`;
    html += '</button>';
    html += '</div>';

    // Page actions (right side)
    html += '<div class="d-flex gap-2">';
    html += '<button class="btn btn-fidonet" onclick="composeMessage(\'echomail\')">';
    html += `<i class="fas fa-plus"></i> ${uiT('ui.echolist.new_post', 'New Post')}`;
    html += '</button>';
    html += '<a class="btn btn-fidonet" href="/echomail">';
    html += `<i class="fas fa-envelope-open-text"></i> ${uiT('ui.echolist.new_messages', 'New Messages')}`;
    html += '</a>';
    html += '</div>';

    html += '</div>';
    // Local first
    if (groups[localLabel] && groups[localLabel].length > 0) {
        html += buildCategory(localLabel, uiT('ui.echolist.local_areas', 'Local Areas'), groups[localLabel], true);
        delete groups[localLabel];
    }

    // Lovlynet second
    if (groups['lovlynet'] && groups['lovlynet'].length > 0) {
        html += buildCategory('lovlynet', uiT('ui.echolist.lovlynet_network', 'LOVLYNET Network'), groups['lovlynet'], false);
        delete groups['lovlynet'];
    }

    // Other networks alphabetically
    Object.keys(groups).sort().forEach(net => {
        if (groups[net].length > 0) {
            html += buildCategory(net, net.toUpperCase() + ' ' + uiT('ui.echolist.network_suffix', 'Network'), groups[net], false);
        }
    });

    $('#forumsContainer').html(html);
}

function buildCategory(id, name, areas, isLocal) {
    const badgeColor = isLocal ? 'bg-success' : 'bg-primary';

    let html = '<div class="card mb-3">';
    html += '<div class="card-header d-flex justify-content-between align-items-center">';
    html += `<h6 class="mb-0"><i class="fas fa-folder me-2"></i>${escapeHtml(name)}</h6>`;
    html += `<span class="badge ${badgeColor}">${areas.length} ${uiT('ui.echolist.area_count', 'area')}${areas.length !== 1 ? uiT('ui.echolist.plural_suffix', 's') : ''}</span>`;
    html += '</div>';
    html += '<div class="list-group list-group-flush">';

    areas.forEach(area => {
        html += buildEchoAreaRow(area);
    });

    html += '</div></div>';
    return html;
}

function buildEchoAreaRow(area) {
    const color = area.color || '#28a745';

    let url = '/echomail?echoarea=' + encodeURIComponent(area.tag);
    if (area.domain) {
        url += '&domain=' + encodeURIComponent(area.domain);
    }

    const unreadCount = area.unread_count || 0;
    const totalCount = area.message_count || 0;
    const isChecked = selectedAreas.has(area.id);

    let html = '<div class="list-group-item">';
    html += '<div class="d-flex align-items-start gap-3">';

    // Bulk-select checkbox
    html += `<div class="form-check area-select-checkbox ${areaSelectMode ? '' : 'd-none'}">`;
    html += `<input type="checkbox" class="form-check-input area-select" value="${area.id}" ${isChecked ? 'checked' : ''} onchange="updateAreaSelection()">`;
    html += '</div>';

    html += `<a href="${url}" class="echoarea-row-link d-flex align-items-start gap-3 flex-grow-1">`;

    // Icon
    html += `<div class="echoarea-icon" style="background-color: ${color};">`;
    html += '<i class="fas fa-comments"></i>';
    html += '</div>';

    // Info
    html += '<div class="flex-grow-1" style="min-width: 0; overflow: hidden;">';
    html += '<div class="echoarea-title">';
    html += escapeHtml(area.tag);
    if (area.is_sysop_only) {
        html += ` <span class="badge bg-warning text-dark">${uiT('ui.echolist.sysop_badge', 'Sysop')}</span>`;
    }
    html += '</div>';
    html += `<div class="echoarea-desc">${escapeHtml(area.description || uiT('ui.echolist.no_description', 'No description'))}</div>`;
    if (area.moderator) {
        html += `<div class="echoarea-mod"><i class="fas fa-user-shield"></i> ${uiT('ui.echolist.moderator_prefix', 'Moderator:')} ${escapeHtml(area.moderator)}</div>`;
    }
    html += '</div>';
    html += '</a>';

    // Stats and last post on the right
    html += '<div class="text-end echoarea-stats">';
    if (unreadCount > 0) {
        html += '<div>';
        html += `<span class="badge bg-secondary">${uiT('ui.echolist.unread_of_posts', '{unread} unread of {total} posts', { unread: unreadCount, total: totalCount })}</span>`;
        html += ` <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="${uiT('ui.echolist.mark_area_read_title', 'Mark this echo area as read')}" onclick="markSingleAreaRead(${area.id}, this)">`;
        html += '<i class="fas fa-envelope-open"></i>';
        html += '</button>';
        html += '</div>';
    } else {
        html += `<div><span class="badge bg-secondary">${uiT('ui.echolist.post_count', '{total} posts', { total: totalCount })}</span></div>`;
    }
    if (area.last_subject) {
        html += `<div class="small text-muted mt-1 d-none d-md-block">`;
        html += `<div class="text-truncate" style="max-width: 200px;" title="${escapeHtml(area.last_subject)}">${escapeHtml(area.last_subject)}</div>`;
        html += `<div>${uiT('ui.echolist.by_author', 'by {author}', { author: escapeHtml(area.last_author || uiT('ui.echolist.unknown', 'Unknown')) })}</div>`;
        html += `<div>${formatDate(area.last_date)}</div>`;
        html += '</div>';
    }
    html += '</div>';

    html += '</div>'; // Close flex container
    html += '</div>'; // Close list-group-item
    return html;
}

function toggleAreaSelectMode() {
    areaSelectMode = !areaSelectMode;
    if (!areaSelectMode) {
        selectedAreas.clear();
    }
    searchEchoAreas(searchQuery);
    $('#areaBulkActionsBar').toggleClass('d-none', !areaSelectMode);
    updateAreaBulkBar();
}

function toggleSelectAllAreas() {
    const checkboxes = $('.area-select');
    const allChecked = checkboxes.length > 0 && checkboxes.filter(':checked').length === checkboxes.length;
    checkboxes.prop('checked', !allChecked);
    updateAreaSelection();
}

function updateAreaSelection() {
    selectedAreas.clear();
    $('.area-select:checked').each(function() {
        selectedAreas.add(parseInt($(this).val()));
    });
    updateAreaBulkBar();
}

function updateAreaBulkBar() {
    $('#areaBulkSelectedCount').text(uiT('ui.echolist.selected_count', 'Selected: {count}', { count: selectedAreas.size }));
    $('#areaBulkMarkReadBtn').prop('disabled', selectedAreas.size === 0);
}

function clearAreaSelection() {
    selectedAreas.clear();
    if (areaSelectMode) {
        toggleAreaSelectMode();
    }
}

function markSelectedAreasAsRead() {
    if (selectedAreas.size === 0) {
        showError(uiT('ui.echolist.none_selected', 'No echo areas selected'));
        return;
    }

    const echoareaIds = Array.from(selectedAreas);
    markEchoAreasAsRead(echoareaIds, $('#areaBulkMarkReadBtn'), function() {
        clearAreaSelection();
    });
}

function markSingleAreaRead(areaId, btnEl) {
    markEchoAreasAsRead([areaId], $(btnEl), null);
}

function markEchoAreasAsRead(echoareaIds, $btn, onSuccess) {
    const originalHtml = $btn.length ? $btn.html() : null;
    if ($btn.length) {
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');
    }

    $.ajax({
        url: '/api/echoareas/mark-read',
        type: 'POST',
        data: JSON.stringify({ echoareaIds: echoareaIds }),
        contentType: 'application/json',
        success: function(response) {
            if (response.success) {
                showSuccess(window.getApiMessage
                    ? window.getApiMessage(response, uiT('ui.echolist.bulk_mark_read_success', 'Marked {count} echo area(s) as read', { count: echoareaIds.length }))
                    : uiT('ui.echolist.bulk_mark_read_success', 'Marked {count} echo area(s) as read', { count: echoareaIds.length }));
                if (onSuccess) onSuccess();
                loadEchoAreas();
                loadStatistics();
            } else {
                showError(apiError(response, uiT('errors.echoareas.bulk_mark_read.failed', 'Failed to mark echo areas as read')));
            }
        },
        error: function(xhr) {
            let errorMessage = uiT('ui.echolist.bulk_mark_read_failed', 'Failed to mark echo areas as read');
            try {
                const response = JSON.parse(xhr.responseText);
                errorMessage = apiError(response, errorMessage);
            } catch (e) {
                // Use default error message
            }
            showError(errorMessage);
        },
        complete: function() {
            if ($btn.length && originalHtml !== null) {
                $btn.prop('disabled', false).html(originalHtml);
            }
        }
    });
}


function searchEchoAreas(query) {
    searchQuery = query.toLowerCase().trim();

    let filtered = allEchoAreas;

    // Apply unread filter
    if ($('#unreadOnlyCheck').is(':checked')) {
        filtered = filtered.filter(f => (f.unread_count || 0) > 0);
    }

    // Apply network filter
    const selectedNets = new Set($('#networkDropdown .network-cb:checked').map(function() { return this.value; }).get());
    if (selectedNets.size > 0) {
        filtered = filtered.filter(f => {
            if (f.is_local) return selectedNets.has('__local__');
            return selectedNets.has(f.domain || uiT('ui.echolist.unknown', 'Unknown'));
        });
    }

    // Apply interest filter
    const selectedInterests = new Set($('#interestDropdown .interest-cb:checked').map(function() { return this.value; }).get());
    if (selectedInterests.size > 0) {
        filtered = filtered.filter(f => {
            const ids = (f.interest_ids || []).map(String);
            return ids.some(id => selectedInterests.has(id));
        });
    }

    // Apply search query
    if (searchQuery !== '') {
        filtered = filtered.filter(f => {
            return f.tag.toLowerCase().includes(searchQuery) ||
                   (f.description && f.description.toLowerCase().includes(searchQuery)) ||
                   (f.moderator && f.moderator.toLowerCase().includes(searchQuery));
        });
    }

    displayEchoAreas(filtered);
}

function searchMessages() {
    const query = $('#messageSearch').val().trim();

    if (query.length < 2) {
        alert(uiT('ui.echolist.search_min_chars', 'Please enter at least 2 characters to search'));
        return;
    }

    // Carry the selected network/interest filters along so the search is scoped
    // the same way the area list on this page is scoped, instead of searching everything.
    const selectedNets = $('#networkDropdown .network-cb:checked').map(function() { return this.value; }).get();
    const selectedInterests = $('#interestDropdown .interest-cb:checked').map(function() { return this.value; }).get();

    const params = new URLSearchParams();
    params.set('search', query);
    if (selectedNets.length > 0) {
        params.set('network', selectedNets.join(','));
    }
    if (selectedInterests.length > 0) {
        // Plural 'interests' to avoid colliding with the existing singular
        // 'interest' param, which selects a single interest browse mode by slug/id.
        params.set('interests', selectedInterests.join(','));
    }

    // Redirect to echomail page with search query
    window.location.href = '/echomail?' + params.toString();
}

function loadStatistics() {
    $.get('/api/messages/echomail/stats')
        .done(function(data) {
            $('#totalMessages').text(data.total || 0);
            $('#recentMessages').text(data.recent || 0);
            $('#totalAreas').text(data.areas || 0);
        });

}

function formatDate(dateStr) {
    if (!dateStr) return uiT('ui.echolist.time.never', 'Never');

    const displayStyle = window.userSettings?.effective_date_display_style || window.userSettings?.date_display_style;
    if (displayStyle === 'date' && typeof window.formatFullDate === 'function') {
        return window.formatFullDate(dateStr);
    }

    // Parse the date - if no timezone info, assume UTC
    let date = new Date(dateStr);

    // If the date string doesn't contain 'Z' or timezone offset, treat it as UTC
    if (!dateStr.includes('Z') && !dateStr.match(/[+-]\d{2}:\d{2}$/)) {
        date = new Date(dateStr + 'Z');
    }

    if (Number.isNaN(date.getTime())) {
        return '-';
    }

    const userDateFormat = window.userSettings?.date_format || 'en-US';
    if (displayStyle === 'date') {
        const userTimezone = window.userSettings?.timezone || 'America/Los_Angeles';
        return date.toLocaleString(userDateFormat, {
            timeZone: userTimezone,
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: 'numeric',
            minute: '2-digit',
            hour12: true
        });
    }

    const now = new Date();
    const diff = Math.floor((now - date) / 1000);

    // Handle negative differences (future dates or clock skew)
    if (diff < 0) {
        return uiT('ui.echolist.time.just_now', 'Just now');
    }

    if (diff < 60) return uiT('ui.echolist.time.just_now', 'Just now');
    if (diff < 3600) return uiT('ui.echolist.time.minutes_ago', '{count}m ago', { count: Math.floor(diff / 60) });
    if (diff < 86400) return uiT('ui.echolist.time.hours_ago', '{count}h ago', { count: Math.floor(diff / 3600) });
    if (diff < 2592000) return uiT('ui.echolist.time.days_ago', '{count}d ago', { count: Math.floor(diff / 86400) });

    return date.toLocaleDateString(userDateFormat);
}
</script>
{% endblock %}
