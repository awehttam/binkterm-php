function deleteFreqRequestAdmin(id) {
    if (!confirm('{{ t('ui.file_requests.delete_confirm')|e('js') }}')) {
        return;
    }
    fetch('/api/freq/requests/' + id, { method: 'DELETE' })
        .then(r => r.json().then(data => ({ ok: r.ok, data: data })))
        .then(function(result) {
            if (result.ok && result.data.success) {
                loadFreqRequestsAdmin();
            } else {
                alert((window.getApiErrorMessage ? window.getApiErrorMessage(result.data, '') : '') || '{{ t('ui.file_requests.delete_failed')|e('js') }}');
