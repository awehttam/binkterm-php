function escapeHtmlFreq(str) {
    const div = document.createElement('div');
    div.textContent = str == null ? '' : String(str);
    return div.innerHTML;
}

function renderFreqRequestsAdminRow(row) {
    const files = (function() {
        try { return JSON.parse(row.requested_files).join(', '); } catch (e) { return row.requested_files; }
    })();
    const badgeMap = { pending: 'bg-warning text-dark', complete: 'bg-success', failed: 'bg-danger' };
    const labelMap = {
        pending: '{{ t('ui.file_requests.status_pending')|e('js') }}',
        complete: '{{ t('ui.file_requests.status_complete')|e('js') }}',
        failed: '{{ t('ui.file_requests.status_failed')|e('js') }}'
    };
