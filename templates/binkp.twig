function loadFreqRequestsAdmin() {
    const body = document.getElementById('freq-requests-admin-rows');
    fetch('/api/freq/requests?all=1')
        .then(r => r.json())
        .then(data => {
            _freqRequestsAdminLoaded = true;
            const rows = data.requests || [];
            if (rows.length === 0) {
                body.innerHTML = '<tr><td colspan="8" class="text-center text-muted p-4">{{ t('ui.binkp.freq_requests.empty')|e('js') }}</td></tr>';
                return;
            }
            body.innerHTML = rows.map(renderFreqRequestsAdminRow).join('');
