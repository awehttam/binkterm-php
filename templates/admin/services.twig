{% extends "base.twig" %}
{% block title %}{{ t('ui.admin.services.page_title', {}, 'common') }}{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">{{ t('ui.admin.services.heading', {}, 'common') }}</h1>
    </div>

    <div id="servicesAlert"></div>

    <div id="servicesCard">
        <div class="card shadow mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0">{{ t('ui.admin.services.managed_services', {}, 'common') }}</h6>
                <button class="btn btn-sm btn-primary" id="saveBtn" onclick="saveServices()" disabled>
                    <i class="fas fa-save me-1"></i>{{ t('ui.admin.services.save', {}, 'common') }}
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>{{ t('ui.admin.services.col_name', {}, 'common') }}</th>
                                <th>{{ t('ui.admin.services.col_command', {}, 'common') }}</th>
                                <th>{{ t('ui.admin.services.col_restart', {}, 'common') }}</th>
                                <th class="text-center">{{ t('ui.admin.services.col_enabled', {}, 'common') }}</th>
                            </tr>
                        </thead>
                        <tbody id="servicesList">
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                                    {{ t('ui.admin.services.loading', {}, 'common') }}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer text-muted small">
                <i class="fas fa-info-circle me-1"></i>
                {{ t('ui.admin.services.footer_note', {}, 'common') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
let currentConfig = null;

document.addEventListener('DOMContentLoaded', function () {
    loadI18nNamespaces(['common', 'errors']).then(function () {
        loadServices();
    });
});

function loadServices() {
    fetch('/admin/api/aio-config')
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data.success) {
                throw new Error(window.getApiErrorMessage ? window.getApiErrorMessage(data, uiT('errors.admin.services.load_failed', 'Failed to load services configuration')) : uiT('errors.admin.services.load_failed', 'Failed to load services configuration'));
            }
            currentConfig = data.config;
            renderServices(data.config.services || []);
            document.getElementById('saveBtn').disabled = false;
        })
        .catch(function (err) { showAlert(err.message, 'danger'); });
}

function renderServices(services) {
    var tbody = document.getElementById('servicesList');
    if (!services.length) {
        tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-4">' +
            escHtml(uiT('ui.admin.services.no_services', 'No services configured.')) + '</td></tr>';
        return;
    }
    tbody.innerHTML = services.map(function (svc) {
        var alwaysOn = !!svc.always_on;
        var enabled  = alwaysOn || !!svc.enabled;
        var cmd      = (svc.command || []).join(' ');
        var badge    = alwaysOn
            ? ' <span class="badge bg-primary ms-1">' + escHtml(uiT('ui.admin.services.badge_required', 'required')) + '</span>'
            : '';
        var toggle   = alwaysOn
            ? '<div class="form-check form-switch d-flex justify-content-center mb-0">' +
              '<input class="form-check-input" type="checkbox" checked disabled' +
              ' title="' + escHtml(uiT('ui.admin.services.always_on_tooltip', 'Always-on services cannot be disabled')) + '">' +
              '</div>'
            : '<div class="form-check form-switch d-flex justify-content-center mb-0">' +
              '<input class="form-check-input service-toggle" type="checkbox"' +
              ' data-name="' + escHtml(svc.name) + '"' +
              (enabled ? ' checked' : '') + '>' +
              '</div>';
        return '<tr>' +
            '<td><strong>' + escHtml(svc.name) + '</strong>' + badge + '</td>' +
            '<td><code class="small text-muted">' + escHtml(cmd) + '</code></td>' +
            '<td><span class="badge bg-light text-dark border">' + escHtml(svc.restart_policy || 'on-failure') + '</span></td>' +
            '<td class="text-center">' + toggle + '</td>' +
            '</tr>';
    }).join('');
}

function saveServices() {
    if (!currentConfig) { return; }
    var updates = [];
    document.querySelectorAll('.service-toggle').forEach(function (el) {
        updates.push({ name: el.dataset.name, enabled: el.checked });
    });
    var btn = document.getElementById('saveBtn');
    btn.disabled = true;
    fetch('/admin/api/aio-config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ services: updates })
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
        btn.disabled = false;
        if (!data.success) {
            throw new Error(window.getApiErrorMessage ? window.getApiErrorMessage(data, uiT('errors.admin.services.save_failed', 'Failed to save services configuration')) : uiT('errors.admin.services.save_failed', 'Failed to save services configuration'));
        }
        showAlert(uiT('ui.admin.services.saved_success', 'Services configuration saved.'), 'success');
    })
    .catch(function (err) {
        btn.disabled = false;
        showAlert(err.message, 'danger');
    });
}

function showAlert(msg, type) {
    var el = document.getElementById('servicesAlert');
    el.innerHTML = '<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert">' +
        escHtml(msg) +
        '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
        '</div>';
}

function uiT(key, fallback) {
    return (window.t ? window.t(key, {}, fallback) : fallback) || fallback;
}

function escHtml(str) {
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
}
</script>
{% endblock %}
